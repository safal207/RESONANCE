{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "neo.resonance.provider-neutral-interoperability.v0.1",
  "title": "Neo Resonance provider-neutral interoperability contract v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "contract_version",
    "case_id",
    "logical_operation_id",
    "execution_id",
    "attempt_id",
    "intent",
    "resolved_target",
    "expected_invariants",
    "evidence_catalog",
    "component_bindings",
    "adjacent_control_planes",
    "authority_boundary",
    "events"
  ],
  "properties": {
    "schema": {"const": "neo.resonance.provider-neutral-interoperability.v0.1"},
    "contract_version": {"const": "0.1"},
    "case_id": {"type": "string", "minLength": 1},
    "logical_operation_id": {"type": "string", "minLength": 1},
    "execution_id": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "intent": {"$ref": "#/$defs/intent"},
    "resolved_target": {"$ref": "#/$defs/target"},
    "expected_invariants": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/invariant"}
    },
    "evidence_catalog": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/evidence"}
    },
    "component_bindings": {
      "type": "array",
      "minItems": 6,
      "items": {"$ref": "#/$defs/component"}
    },
    "adjacent_control_planes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/adjacent"}
    },
    "authority_boundary": {"$ref": "#/$defs/authority"},
    "events": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {"$ref": "#/$defs/event"}
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution_authorized", "mutation_authorized", "external_effects_authorized"],
      "properties": {
        "execution_authorized": {"const": false},
        "mutation_authorized": {"const": false},
        "external_effects_authorized": {"const": false}
      }
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent_id", "kind", "purpose", "argument_digest", "expected_outcome"],
      "properties": {
        "intent_id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "argument_digest": {"$ref": "#/$defs/digest"},
        "expected_outcome": {"type": "string", "minLength": 1}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route", "scope"],
      "properties": {
        "route": {
          "type": "array",
          "const": ["intent", "proofpath", "cml", "liminaldb", "rinse", "contractgraph_qa"]
        },
        "scope": {"type": "string", "minLength": 1}
      }
    },
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "statement": {"type": "string", "minLength": 1}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "role", "digest"],
      "properties": {
        "ref": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "repository", "revision", "role"],
      "properties": {
        "component": {"type": "string", "minLength": 1},
        "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "role": {"type": "string", "minLength": 1}
      }
    },
    "adjacent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "repository", "revision", "role", "in_primary_proof_route", "semantic_authority"],
      "properties": {
        "component": {"type": "string", "minLength": 1},
        "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "role": {"type": "string", "minLength": 1},
        "in_primary_proof_route": {"const": false},
        "semantic_authority": {"const": "cml"}
      }
    },
    "time_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from"],
      "properties": {
        "from": {"type": "string", "format": "date-time"},
        "to": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["native_path", "binding_kind", "semantic_status"],
      "properties": {
        "native_path": {"type": "string", "minLength": 1},
        "binding_kind": {"enum": ["identity", "derived_reference", "structured_projection"]},
        "semantic_status": {"const": "preserved"}
      }
    },
    "field_map": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logical_operation_id",
        "execution_id",
        "attempt_id",
        "parent_cause",
        "intent",
        "resolved_target",
        "expected_invariants",
        "observed_outcome",
        "phase",
        "valid_time",
        "transaction_time",
        "recovery_state",
        "verification_refs"
      ],
      "properties": {
        "logical_operation_id": {"$ref": "#/$defs/mapping"},
        "execution_id": {"$ref": "#/$defs/mapping"},
        "attempt_id": {"$ref": "#/$defs/mapping"},
        "parent_cause": {"$ref": "#/$defs/mapping"},
        "intent": {"$ref": "#/$defs/mapping"},
        "resolved_target": {"$ref": "#/$defs/mapping"},
        "expected_invariants": {"$ref": "#/$defs/mapping"},
        "observed_outcome": {"$ref": "#/$defs/mapping"},
        "phase": {"$ref": "#/$defs/mapping"},
        "valid_time": {"$ref": "#/$defs/mapping"},
        "transaction_time": {"$ref": "#/$defs/mapping"},
        "recovery_state": {"$ref": "#/$defs/mapping"},
        "verification_refs": {"$ref": "#/$defs/mapping"}
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "native_schema", "field_map"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
        "native_schema": {"type": "string", "minLength": 1},
        "field_map": {"$ref": "#/$defs/field_map"}
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "decision", "summary"],
      "properties": {
        "status": {"type": "string", "minLength": 1},
        "decision": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1}
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "phase",
        "logical_operation_id",
        "execution_id",
        "attempt_id",
        "intent_id",
        "parent_cause",
        "intent",
        "resolved_target",
        "expected_invariants",
        "observed_outcome",
        "valid_time",
        "transaction_time",
        "recovery_state",
        "verification_refs",
        "authority_boundary",
        "native_projection"
      ],
      "properties": {
        "event_id": {"type": "string", "minLength": 1},
        "phase": {"enum": ["intent", "proofpath", "cml", "liminaldb", "rinse", "contractgraph_qa"]},
        "logical_operation_id": {"type": "string", "minLength": 1},
        "execution_id": {"type": "string", "minLength": 1},
        "attempt_id": {"type": "string", "minLength": 1},
        "intent_id": {"type": "string", "minLength": 1},
        "parent_cause": {"type": ["string", "null"]},
        "intent": {"type": "object"},
        "resolved_target": {
          "type": "object",
          "required": ["component", "operation", "scope"],
          "properties": {
            "component": {"type": "string", "minLength": 1},
            "operation": {"type": "string", "minLength": 1},
            "scope": {"type": "string", "minLength": 1}
          }
        },
        "expected_invariants": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "observed_outcome": {"$ref": "#/$defs/outcome"},
        "valid_time": {"$ref": "#/$defs/time_window"},
        "transaction_time": {"type": "string", "format": "date-time"},
        "recovery_state": {"type": "string", "minLength": 1},
        "verification_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "authority_boundary": {"$ref": "#/$defs/authority"},
        "native_projection": {"$ref": "#/$defs/projection"}
      }
    }
  }
}
