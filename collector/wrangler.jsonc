{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "resonance-analytics-collector",
  "main": "./worker.mjs",
  "compatibility_date": "2026-08-12",
  "workers_dev": true,
  "observability": {
    "enabled": false
  },
  "analytics_engine_datasets": [
    {
      "binding": "RESONANCE_EVENTS",
      "dataset": "resonance_market_events_v1"
    }
  ]
}
