{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/safal207/RESONANCE/protocols/recovery-integrity-v0.1/schema/recovery-integrity-record.schema.json",
  "title": "RecoveryIntegrityRecord v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "recovery_id",
    "source_case_ref",
    "authority",
    "projection",
    "rollout",
    "external_side_effect_state",
    "decision",
    "evidence_refs",
    "verifier",
    "pre_recovery_snapshot_ref",
    "post_recovery_snapshot_ref",
    "observed_outcome"
  ],
  "properties": {
    "protocol_version": {"const": "recovery-integrity-v0.1"},
    "recovery_id": {"type": "string", "minLength": 1},
    "source_case_ref": {"type": "string", "minLength": 1},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ref", "generation", "integrity"],
      "properties": {
        "source_ref": {"type": "string", "minLength": 1},
        "generation": {"type": ["integer", "null"], "minimum": 0},
        "integrity": {"enum": ["VALID", "INVALID", "UNKNOWN"]}
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ref", "generation", "state", "preserved_broken_ref"],
      "properties": {
        "source_ref": {"type": "string", "minLength": 1},
        "generation": {"type": ["integer", "null"], "minimum": 0},
        "state": {"enum": ["HEALTHY", "MISSING", "STALE", "CORRUPT", "UNPROVABLE"]},
        "preserved_broken_ref": {"type": ["string", "null"]}
      }
    },
    "rollout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ref", "integrity", "continuation_proof"],
      "properties": {
        "source_ref": {"type": ["string", "null"]},
        "integrity": {"enum": ["VALID", "INVALID", "UNKNOWN"]},
        "continuation_proof": {"enum": ["PROVEN", "NOT_PROVEN", "CONTRADICTED"]}
      }
    },
    "last_committed_action_ref": {"type": ["string", "null"]},
    "pending_action_ref": {"type": ["string", "null"]},
    "external_side_effect_state": {"enum": ["NONE", "KNOWN_COMMITTED", "KNOWN_NOT_COMMITTED", "AMBIGUOUS", "UNKNOWN"]},
    "current_authority_proof": {"enum": ["PROVEN", "NOT_REQUIRED", "NOT_PROVEN", "CONTRADICTED"]},
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rebuild_projection", "execution_continuation"],
      "properties": {
        "rebuild_projection": {"enum": ["ALLOW_REBUILD", "NO_REBUILD", "HOLD"]},
        "execution_continuation": {"enum": ["ALLOW_FORK", "NO_CONTINUATION", "HOLD"]}
      }
    },
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verifier_id", "mode"],
      "properties": {
        "verifier_id": {"type": "string", "minLength": 1},
        "mode": {"const": "read-only"}
      }
    },
    "pre_recovery_snapshot_ref": {"type": ["string", "null"]},
    "post_recovery_snapshot_ref": {"type": ["string", "null"]},
    "observed_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "outcome_ref"],
      "properties": {
        "status": {"enum": ["NOT_OBSERVED", "REBUILD_SUCCEEDED", "REBUILD_FAILED", "FORK_SUCCEEDED", "FORK_FAILED", "HELD"]},
        "outcome_ref": {"type": ["string", "null"]}
      }
    }
  }
}
